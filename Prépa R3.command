#!/bin/bash
# Ce script est fusionné dans "Prépa R2-3.command" (choix R2/R3 après le
# nom du client) — conservé ici uniquement pour ne pas casser un alias
# Bureau existant. À supprimer (ainsi que son alias) quand tu veux.
echo "Ce raccourci n'est plus utilisé : ouvre \"Prépa R2-3.command\" et choisis R3 quand il te le demande."
read -r -p "Appuyez sur Entrée pour fermer..." _
